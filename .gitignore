
# ==========================================
# SmartCart - Dataset files
# ==========================================

# Ignore all raw datasets
data/raw/*
!data/raw/.gitkeep

# Ignore processed datasets and generated metadata
data/processed/*
!data/processed/.gitkeep

# Ignore demo datasets by default
data/demo/*
!data/demo/.gitkeep

# ==========================================
# Generated outputs and trained models
# ==========================================

outputs/*
!outputs/.gitkeep

# Common model artifacts
*.pkl
*.joblib
*.h5
*.pt
*.pth

# ==========================================
# Python environments and cache
# ==========================================

venv/
.venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/

# ==========================================
# IDE and operating system files
# ==========================================

.vscode/
.idea/
.DS_Store
Thumbs.db
